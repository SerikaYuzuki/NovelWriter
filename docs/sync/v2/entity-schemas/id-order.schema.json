{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v2:entity:id-order",
  "type": "object",
  "additionalProperties": false,
  "required": ["ids"],
  "properties": {
    "ids": {
      "type": "array",
      "maxItems": 100000,
      "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
    }
  }
}
