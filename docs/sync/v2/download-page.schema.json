{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuminiwa.invalid/sync/v2/download-page.schema.json",
  "title": "Snapshot Sync v2 immutable graph download page",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "snapshotId", "items", "nextCursor"],
  "properties": {
    "result": { "const": "noChanges" },
    "snapshotId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "bytesBase64URL"],
        "properties": {
          "kind": { "enum": ["manifest", "object"] },
          "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytesBase64URL": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" }
        }
      }
    },
    "nextCursor": { "type": ["string", "null"], "minLength": 1, "maxLength": 2048 }
  }
}
