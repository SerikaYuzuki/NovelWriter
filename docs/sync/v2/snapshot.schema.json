{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v2:snapshot",
  "title": "FUMINIWA Snapshot Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "parentSnapshotIds", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "workId": { "$ref": "#/$defs/uuid" },
    "parentSnapshotIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "entries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/entry" },
      "allOf": [
        { "$ref": "#/$defs/hasWorkDocument" },
        { "$ref": "#/$defs/hasWorkTitle" },
        { "$ref": "#/$defs/hasWorkSynopsis" },
        { "$ref": "#/$defs/hasChapterOrder" },
        { "$ref": "#/$defs/hasCharacterOrder" },
        { "$ref": "#/$defs/hasPlotCardOrder" },
        { "$ref": "#/$defs/hasFlagOrder" },
        { "$ref": "#/$defs/hasWorldNoteOrder" },
        { "$ref": "#/$defs/hasAttachmentOrder" }
      ]
    }
  },
  "$defs": {
    "hasWorkDocument": { "contains": { "properties": { "entityKey": { "const": "work/document" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasWorkTitle": { "contains": { "properties": { "entityKey": { "const": "work/title" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasWorkSynopsis": { "contains": { "properties": { "entityKey": { "const": "work/synopsis" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasChapterOrder": { "contains": { "properties": { "entityKey": { "const": "work/chapter-order" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasCharacterOrder": { "contains": { "properties": { "entityKey": { "const": "work/character-order" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasPlotCardOrder": { "contains": { "properties": { "entityKey": { "const": "work/plot-card-order" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasFlagOrder": { "contains": { "properties": { "entityKey": { "const": "work/flag-order" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasWorldNoteOrder": { "contains": { "properties": { "entityKey": { "const": "work/world-note-order" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "hasAttachmentOrder": { "contains": { "properties": { "entityKey": { "const": "work/attachment-order" } }, "required": ["entityKey"] }, "minContains": 1, "maxContains": 1 },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteCount", "contentType", "entityKey", "objectId"],
      "properties": {
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 262144000 },
        "contentType": {
          "type": "string",
          "enum": [
            "application/vnd.fuminiwa.entity+json;version=2",
            "application/octet-stream"
          ]
        },
        "entityKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "objectId": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
