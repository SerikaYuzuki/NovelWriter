{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v2:snapshot",
  "title": "FUMINIWA Snapshot Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "parentSnapshotIds", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "workId": { "$ref": "#/$defs/uuid" },
    "parentSnapshotIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteCount", "contentType", "entityKey", "objectId"],
      "properties": {
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 262144000 },
        "contentType": {
          "type": "string",
          "enum": [
            "application/vnd.fuminiwa.entity+json;version=2",
            "application/octet-stream"
          ]
        },
        "entityKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "objectId": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
