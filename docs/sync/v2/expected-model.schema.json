{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v2:expected-model",
  "type": "object",
  "additionalProperties": false,
  "required": ["attachments", "document", "schemaVersion", "workId"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workId": { "$ref": "#/$defs/uuid" },
    "document": { "$ref": "#/$defs/document" },
    "attachments": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/attachment" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "string": { "type": "string", "maxLength": 1048576 },
    "optionalString": { "type": ["string", "null"], "maxLength": 1048576 },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapters",
        "characters",
        "documentCreatedAt",
        "flags",
        "id",
        "plotCards",
        "synopsis",
        "title",
        "worldNotes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "documentCreatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "title": { "$ref": "#/$defs/string" },
        "synopsis": { "$ref": "#/$defs/string" },
        "chapters": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/chapter" }
        },
        "characters": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/character" }
        },
        "plotCards": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/plotCard" }
        },
        "flags": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/flag" }
        },
        "worldNotes": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/worldNote" }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodes", "id", "title"],
      "properties": {
        "episodes": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/episode" }
        },
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "$ref": "#/$defs/string" }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "id", "memo", "title"],
      "properties": {
        "content": { "$ref": "#/$defs/string" },
        "id": { "$ref": "#/$defs/uuid" },
        "memo": { "$ref": "#/$defs/string" },
        "title": { "$ref": "#/$defs/string" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "age",
        "appearance",
        "background",
        "colorHex",
        "firstPerson",
        "gender",
        "id",
        "kana",
        "memo",
        "name",
        "personality",
        "role",
        "secondPerson",
        "speechStyle"
      ],
      "properties": {
        "age": { "$ref": "#/$defs/optionalString" },
        "appearance": { "$ref": "#/$defs/optionalString" },
        "background": { "$ref": "#/$defs/optionalString" },
        "colorHex": { "type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$" },
        "firstPerson": { "$ref": "#/$defs/optionalString" },
        "gender": { "$ref": "#/$defs/optionalString" },
        "id": { "$ref": "#/$defs/uuid" },
        "kana": { "$ref": "#/$defs/string" },
        "memo": { "$ref": "#/$defs/string" },
        "name": { "$ref": "#/$defs/string" },
        "personality": { "$ref": "#/$defs/optionalString" },
        "role": { "$ref": "#/$defs/optionalString" },
        "secondPerson": { "$ref": "#/$defs/optionalString" },
        "speechStyle": { "$ref": "#/$defs/optionalString" }
      }
    },
    "plotCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapterId", "id", "memo", "title"],
      "properties": {
        "chapterId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "id": { "$ref": "#/$defs/uuid" },
        "memo": { "$ref": "#/$defs/string" },
        "title": { "$ref": "#/$defs/string" }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "isResolved", "note", "plantedChapterId", "resolvedChapterId", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "isResolved": { "type": "boolean" },
        "note": { "$ref": "#/$defs/string" },
        "plantedChapterId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "resolvedChapterId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "title": { "$ref": "#/$defs/string" }
      }
    },
    "worldNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "id", "title"],
      "properties": {
        "content": { "$ref": "#/$defs/string" },
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "$ref": "#/$defs/string" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentId", "byteCount", "fileName", "objectId"],
      "properties": {
        "attachmentId": { "$ref": "#/$defs/uuid" },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 262144000 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "objectId": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
