{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v2:scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["expect", "name", "schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "initial": { "type": "object" },
    "event": { "$ref": "#/$defs/event" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "cases": { "type": "array", "items": { "type": "object" } },
    "choices": { "type": "array", "items": { "enum": ["useDevice", "useServer", "keepBoth"] }, "uniqueItems": true },
    "expectedModelFixture": { "type": "string", "const": "../canonical/expected-model.json" },
    "commitRequires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "expect": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "accountSwitch",
            "beginKeepBoth",
            "dropResponseAfterCommit",
            "explicitSync",
            "exportBackup",
            "fenceChange",
            "finalizeOldUpload",
            "foreignRead",
            "getReceipt",
            "importAsNewWork",
            "injectFailure",
            "installRemote",
            "localEdit",
            "materializeSnapshot",
            "packageReadBack",
            "prepare",
            "processKill",
            "publish",
            "resolveConflict",
            "restart",
            "restore",
            "retry",
            "rustMaterializeSnapshot",
            "seal",
            "sendExactCommand",
            "stage",
            "swiftExportNovelpkgV3",
            "tapConflictChoice",
            "transactionRollback",
            "workerWake"
          ]
        }
      }
    }
  },
  "anyOf": [ { "required": ["event"] }, { "required": ["events"] }, { "required": ["cases"] } ]
}
