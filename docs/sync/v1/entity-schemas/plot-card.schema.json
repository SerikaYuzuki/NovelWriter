{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v1:entity:plot-card",
  "title": "Plot Card Entity v1",
  "$comment": "The payload id must equal the UUID segment of its plot-card/{id} EntityKey; the work/plot-card-order payload carries display order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "memo",
    "chapterId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/lowercaseUuid"
    },
    "title": {
      "type": "string",
      "maxLength": 4096
    },
    "memo": {
      "type": "string",
      "maxLength": 1000000
    },
    "chapterId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/lowercaseUuid"
        }
      ]
    }
  },
  "$defs": {
    "lowercaseUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
