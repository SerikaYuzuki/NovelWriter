{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminiwa:sync:v1:entity:id-order",
  "title": "Ordered ID List Entity v1",
  "description": "The array order is authoritative. IDs must be unique and must not be sorted by an implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ids"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  }
}
