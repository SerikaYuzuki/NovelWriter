  "bindings": {
    "accountA": {"serverInstanceId": "90000000-0000-0000-0000-000000000001", "protocolEpoch": 1, "accountId": "91000000-0000-0000-0000-000000000001", "accountAuthEpoch": 1, "accountFence": "ZmVuY2UtYWNjb3VudC1hLXYx"},
    "accountB": {"serverInstanceId": "90000000-0000-0000-0000-000000000001", "protocolEpoch": 1, "accountId": "91000000-0000-0000-0000-000000000002", "accountAuthEpoch": 1, "accountFence": "ZmVuY2UtYWNjb3VudC1iLXYx"},
    "accountANewFence": {"serverInstanceId": "90000000-0000-0000-0000-000000000001", "protocolEpoch": 1, "accountId": "91000000-0000-0000-0000-000000000001", "accountAuthEpoch": 2, "accountFence": "ZmVuY2UtYWNjb3VudC1hLXYy"},
    "replacementServerA": {"serverInstanceId": "90000000-0000-0000-0000-000000000002", "protocolEpoch": 1, "accountId": "91000000-0000-0000-0000-000000000001", "accountAuthEpoch": 1, "accountFence": "ZmVuY2UtYWNjb3VudC1hLXYx"}
  },
