    "uuidParsePolicy": "caseInsensitiveHyphenated36To128BitLogicalValue"
  },
  "expectedLocalAndWire": {
    "documentId": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
    "reservedImportWorkIdNotReadFromPackage": "9aaf8ad1-4598-4e9f-b16c-caba5a3e7be8",
    "episodeId": "abcdefab-cdef-abcd-efab-cdefabcdefab",
    "entityKey": "episode/abcdefab-cdef-abcd-efab-cdefabcdefab/body",
    "workDocumentCanonicalUtf8": "{\"documentCreatedAt\":\"2026-08-15T00:00:00Z\",\"documentId\":\"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee\",\"schemaVersion\":1}",
    "workDocumentByteCount": 114,
    "workDocumentObjectId": "1f58c2781a587e75d51b7ba356bbdb85115a39f5c5d768e56422d65a28b768b6"
  },
  "expectedPackageExport": {
