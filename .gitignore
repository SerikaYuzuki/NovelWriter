# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
DerivedData/
.derivedData/
# XcodeGen で生成する生成物(docs/DECISIONS.md D-008)。正は project.yml。
*.xcodeproj/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Per-developer Apple signing selection. The checked-in wrapper/example live in
# Config; only the local Team ID override stays untracked.
/Config/Signing.local.xcconfig

# Build products
build/
*.o
*.dSYM.zip
*.dSYM

# Retired sidecar artifacts, if present locally, are not source.
/Sidecars/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# CocoaPods / Carthage / SwiftPM legacy artifacts (not used, but ignore if introduced)
Pods/
Carthage/Build/

# Fastlane (in case introduced later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Editor / tooling
.vscode/
.idea/
*.swp
.claude/settings.local.json

# Retired server local settings/builds remain private after source removal.
/SyncServer/.env
/SyncServer/target/
