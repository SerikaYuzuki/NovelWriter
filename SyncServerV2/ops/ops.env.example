# Copy to a private file on the server; never put keys/passwords here.
FUMINIWA_BACKUP_TZ=Asia/Tokyo
FUMINIWA_BACKUP_TIME=03:17
FUMINIWA_BACKUP_DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
FUMINIWA_BACKUP_DIRECTORY_HOST_PATH=/DATA/AppData/fuminiwa-sync-v2-role-split/operational-backups/daily
FUMINIWA_BACKUP_CONFIG_HOST_PATH=/DATA/AppData/fuminiwa-sync-v2-role-split/operational-backups/backup-config.json
FUMINIWA_BACKUP_KEY_HOST_PATH=/DATA/AppData/fuminiwa-sync-v2-role-split/backup-keys/backup-aes256.key
FUMINIWA_BACKUP_POSTGRES_CONTAINER=fuminiwa-sync-v2-role-split-postgres
FUMINIWA_BACKUP_SERVER_CONTAINER=fuminiwa-sync-v2-role-split-server
