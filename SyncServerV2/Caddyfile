{
    auto_https disable_redirects
    # URLSession and BusyBox probes may omit SNI for an IP-literal URL.
    # Select the LAN staging certificate in that case as well.
    default_sni {$FUMINIWA_SYNC_V2_EDGE_HOST:192.168.11.5}
}

https://{$FUMINIWA_SYNC_V2_EDGE_HOST:192.168.11.5}:8443 {
    # tls internal is a staging-only local CA. Production must terminate with
    # a publicly trusted certificate at the deployment edge.
    tls internal
    header {
        Cache-Control "no-store"
        Pragma "no-cache"
    }
    reverse_proxy server:8092
}
