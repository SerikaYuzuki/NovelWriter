# All *_FILE and *_HOST_PATH values below must point to files in the v2-only
# runtime directory prepared by scripts/prepare-runtime-secrets.sh.  Do not
# point them at operator originals with mode 0600 owned by another account.
# Consumed only by docker-compose.provision.yml for a fresh volume. Exact-v2
# restart uses only docker-compose.yml and never renders/mounts this secret.
FUMINIWA_SYNC_V2_POSTGRES_INIT_PASSWORD_HOST_PATH=
# Used by the provision one-shot and the fresh migrator fallback. The role is
# NOLOGIN after provisioning, so exact-v2 repeat connects permanent bootstrap.
FUMINIWA_SYNC_V2_BOOTSTRAP_ADMIN_PASSWORD_HOST_PATH=
FUMINIWA_SYNC_V2_BOOTSTRAP_PASSWORD_FILE=
FUMINIWA_SYNC_V2_MIGRATION_PASSWORD_HOST_PATH=
FUMINIWA_SYNC_V2_RUNTIME_PASSWORD_HOST_PATH=
FUMINIWA_SYNC_V2_EDGE_HOST=192.168.11.5
FUMINIWA_SYNC_V2_EDGE_PORT=8443
FUMINIWA_SERVER_INSTANCE_ID=
FUMINIWA_AUTH_VAULT_KEY_VERSION=
FUMINIWA_AUTH_VAULT_KEY_HOST_PATH=
FUMINIWA_AUTH_VAULT_KEYRING_HOST_PATH=
FUMINIWA_AUTH_SUBJECT_HMAC_KEY_HOST_PATH=
FUMINIWA_AUTH_TOKEN_HMAC_KEY_HOST_PATH=
FUMINIWA_APPLE_TEAM_ID=
FUMINIWA_APPLE_KEY_ID=
FUMINIWA_APPLE_MAC_CLIENT_ID=
FUMINIWA_APPLE_IOS_CLIENT_ID=
FUMINIWA_APPLE_PRIVATE_KEY_HOST_PATH=

# Opt-in role-split PostgreSQL gate only. These point at three separately
# provisioned disposable databases; the runner never creates or drops them.
FUMINIWA_V2_ROLE_SPLIT_TEST_DATABASE_URL=
FUMINIWA_V2_ROLE_SPLIT_UNKNOWN_DATABASE_URL=
FUMINIWA_V2_ROLE_SPLIT_SINGLE_ROLE_DATABASE_URL=
FUMINIWA_V2_ROLE_SPLIT_SERVER_INSTANCE_ID=
FUMINIWA_V2_ROLE_SPLIT_BOOTSTRAP_ADMIN_PASSWORD_FILE=
FUMINIWA_V2_ROLE_SPLIT_BOOTSTRAP_PASSWORD_FILE=
FUMINIWA_V2_ROLE_SPLIT_MIGRATION_PASSWORD_FILE=
FUMINIWA_V2_ROLE_SPLIT_RUNTIME_PASSWORD_FILE=
FUMINIWA_V2_MIGRATOR_BIN=
