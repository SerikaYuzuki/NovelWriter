# FUMINIWA — SwiftFormat 設定
#
# 対象: リポジトリ内のSwiftソース全体
# ビルド生成物・Package.swiftは除外しているため、App／iOS／testの移動後も
# 同じ設定で検査できる。
#
# 方針: 既存プレースホルダコードのスタイル(4スペースインデント、
# K&R式の中括弧、ファイルスコープの #if を追加インデントしない)に
# 合わせた、控えめな設定。過度な自動書き換えは行わない。

--swiftversion 6.0
--language-mode 6
--min-version 0.62.0
--indent 4
--indentcase false
--ifdef no-indent
--trimwhitespace always
--elseposition same-line
--guardelse same-line
--emptybraces no-space

# SwiftFormat 0.62 のデフォルトは複数行statementの `{` を次行へ移すが、
# リポジトリのK&R方針とSwiftLintのopening_braceルールに反するため無効化する。
--disable wrapMultilineStatementBraces

# SwiftFormat 0.62 のデフォルト(always)は複数行リストに末尾カンマを追加するが、
# SwiftLint デフォルトの trailing_comma ルールは末尾カンマを禁止しており衝突する。
# 既存コードのスタイル(末尾カンマなし)と SwiftLint に合わせて never にする。
--trailing-commas never

# ビルド生成物・パッケージマニフェストは対象外
--exclude NovelKit/.build,NovelKit/.swiftpm,NovelKit/Package.swift,.build,.swiftpm,.git
